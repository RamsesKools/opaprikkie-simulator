# Backend settings, all optional; defaults shown.
OPAPRIKKIE_HOST=127.0.0.1
OPAPRIKKIE_PORT=8000
# Enables /docs, /openapi.json, and the dev-only game options.
OPAPRIKKIE_DEV_MODE=false
OPAPRIKKIE_MAX_SESSIONS=50
OPAPRIKKIE_SESSION_TTL_DAYS=7
# Turn on behind HTTPS.
OPAPRIKKIE_COOKIE_SECURE=false
OPAPRIKKIE_STATIC_DIR=frontend/dist
