  "components": {
    "schemas": {
      "Controller": {
        "type": "string",
        "enum": [
          "human",
          "ai"
        ],
        "title": "Controller"
      },
      "DiceOffRoll": {
        "properties": {
          "player": {
            "type": "integer",
            "title": "Player"
          },
          "dice": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Dice"
          }
        },
        "type": "object",
        "required": [
          "player",
          "dice"
        ],
        "title": "DiceOffRoll"
      },
      "DiceOffRound": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "dice_off",
            "title": "Kind"
          },
          "rolls": {
            "items": {
              "$ref": "#/components/schemas/DiceOffRoll"
            },
            "type": "array",
            "title": "Rolls"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "rolls"
        ],
        "title": "DiceOffRound"
      },
      "Error": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "Error",
        "description": "Every error body: a `code`, a `message`, and hints that depend on the code."
      },
      "FirstPlayer": {
        "properties": {
          "player": {
            "type": "integer",
            "title": "Player"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "player"
        ],
        "title": "FirstPlayer"
      },
      "Game": {
        "properties": {
          "ruleset": {
            "type": "string",
            "title": "Ruleset"
          },
          "phase": {
            "$ref": "#/components/schemas/Phase"
          },
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Names"
          },
          "controllers": {
            "items": {
              "$ref": "#/components/schemas/Controller"
            },
            "type": "array",
            "title": "Controllers"
          },
          "pegs": {
            "items": {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            "type": "array",
            "title": "Pegs"
          },
          "observation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Observation"
              },
              {
                "type": "null"
              }
            ]
          },
          "winner": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Winner"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "strategy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Strategy"
          }
        },
        "type": "object",
        "required": [
          "ruleset",
          "phase",
          "names",
          "controllers",
          "pegs",
          "observation",
          "winner",
          "seed",
          "strategy"
        ],
        "title": "Game",
        "description": "The game state; `seed` and `strategy` are shown in dev mode only."
      },
      "GameUpdate": {
        "properties": {
          "game": {
            "$ref": "#/components/schemas/Game"
          },
          "logs": {
            "items": {
              "$ref": "#/components/schemas/LogEntry"
            },
            "type": "array",
            "title": "Logs"
          }
        },
        "type": "object",
        "required": [
          "game",
          "logs"
        ],
        "title": "GameUpdate",
        "description": "The game after an action, with every log entry it produced."
      },
      "Health": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "dev_mode": {
            "type": "boolean",
            "title": "Dev Mode"
          },
          "strategies": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Strategies"
          }
        },
        "type": "object",
        "required": [
          "version",
          "dev_mode",
          "strategies"
        ],
        "title": "Health",
        "description": "The version handshake; `strategies` lists the built-ins in dev mode only."
      },
      "LegalTarget": {
        "properties": {
          "target": {
            "type": "integer",
            "title": "Target"
          },
          "matches": {
            "type": "integer",
            "title": "Matches"
          },
          "guaranteed_moves": {
            "type": "integer",
            "title": "Guaranteed Moves"
          },
          "set_aside": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Set Aside"
          }
        },
        "type": "object",
        "required": [
          "target",
          "matches",
          "guaranteed_moves",
          "set_aside"
        ],
        "title": "LegalTarget"
      },
      "LogEntry": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/DiceOffRound"
          },
          {
            "$ref": "#/components/schemas/RollSequence"
          },
          {
            "$ref": "#/components/schemas/NoMove"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "dice_off": "#/components/schemas/DiceOffRound",
            "no_move": "#/components/schemas/NoMove",
            "roll_sequence": "#/components/schemas/RollSequence"
          }
        }
      },
      "Names": {
        "properties": {
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Names"
          }
